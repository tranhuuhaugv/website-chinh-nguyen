# URL công khai của site (dùng cho metadata, canonical, sitemap, robots, JSON-LD).
# Khi deploy: đổi thành domain thật của bạn.
NEXT_PUBLIC_SITE_URL=https://laptopchinhnguyen.vn

# Kết nối PostgreSQL (Prisma). Trên VPS: postgresql://user:pass@localhost:5432/tendb
DATABASE_URL=

# Cloudinary — để bật tải ảnh thật trong admin (ảnh sản phẩm, blog, banner).
# 1) Tạo tài khoản Cloudinary (miễn phí) -> lấy "Cloud name".
# 2) Settings -> Upload -> thêm "Upload preset", chọn Signing Mode = Unsigned -> lấy tên preset.
# Chưa đặt 2 biến này thì phần tải ảnh chạy ở chế độ demo (chỉ xem trước).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Gửi email thông báo đơn hàng (thu cũ + mua hàng) về Gmail.
# 1) Bật xác minh 2 bước cho Gmail.
# 2) Tạo "App password" (Mật khẩu ứng dụng) tại: myaccount.google.com/apppasswords
# Chưa đặt thì đơn vẫn nhận được nhưng KHÔNG gửi email (chế độ demo).
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=

# Đăng nhập khu quản trị /admin
ADMIN_EMAIL=admin@laptopchinhnguyen.com.vn
ADMIN_PASSWORD=DoiMatKhauQuanTriManh
# Chuỗi bí mật để ký phiên đăng nhập (chuỗi ngẫu nhiên dài, VD dùng: openssl rand -base64 32)
AUTH_SECRET=

# Đăng nhập bằng Google (nút "Tiếp tục với Google").
# 1) console.cloud.google.com -> tạo project -> "APIs & Services" -> "Credentials"
#    -> Create Credentials -> OAuth client ID -> Application type: Web application.
# 2) Authorized redirect URIs, thêm 2 dòng:
#      http://localhost:3000/api/auth/google/callback   (chạy thử local)
#      https://<domain-that>/api/auth/google/callback    (production)
# 3) Copy Client ID + Client secret dán vào đây.
# Chưa đặt 2 biến này thì nút Google báo "chưa cấu hình" (phần còn lại vẫn chạy).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

