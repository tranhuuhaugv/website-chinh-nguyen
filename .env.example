# URL công khai của site (dùng cho metadata, canonical, sitemap, robots, JSON-LD).
# Khi deploy: đổi thành domain thật của bạn.
NEXT_PUBLIC_SITE_URL=https://laptopchinhnguyen.vn

# Cloudinary — để bật tải ảnh thật trong admin (ảnh sản phẩm, blog, banner).
# 1) Tạo tài khoản Cloudinary (miễn phí) -> lấy "Cloud name".
# 2) Settings -> Upload -> thêm "Upload preset", chọn Signing Mode = Unsigned -> lấy tên preset.
# Chưa đặt 2 biến này thì phần tải ảnh chạy ở chế độ demo (chỉ xem trước).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
