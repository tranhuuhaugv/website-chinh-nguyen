// Prisma schema — Laptop Chính Nguyễn
// Chạy migrate/seed trên VPS với DATABASE_URL trỏ tới PostgreSQL trên VPS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Category {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  icon  String
  tag   String?
  image String? // ảnh đại diện (thẻ danh mục ở trang chủ / mega-menu)
  coverImage String? // ảnh bìa NGANG riêng cho đầu trang danh mục (hero)
  group String? // nhóm cho mega-menu: nhu-cau | thuong-hieu | khac
  sort  Int     @default(0)
  metaDescription String? // thẻ meta description riêng cho trang danh mục (SEO)
  seoContent      String? // bài viết SEO (HTML) hiện DƯỚI danh sách sản phẩm
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  brand       Brand   @relation(fields: [brandId], references: [id])
  brandId     String
  price       Int
  oldPrice    Int?
  // Cấu hình chi tiết
  cpu         String
  ram         String
  storage     String
  capacity    String? // dung lượng gộp hiển thị nhanh, VD "8GB - 256GB"
  color       String? // màu sắc máy
  gpu         String? // Card VGA
  mux         String? // MUX Switch: "Có" / "Không"
  webcam      String?
  screen      String?
  resolution  String?
  refresh     String?
  os          String?
  battery     String?
  weight      String?
  ports       String?
  warranty    String?
  // Bán hàng
  rating              Float   @default(5)
  reviewCount         Int     @default(0)
  installmentPerMonth Int?
  gift                String?
  badge               String?
  isNew               Boolean @default(false)
  isFeatured          Boolean @default(false) // hiện ở khối "Sản phẩm nổi bật" trang chủ
  condition           String  @default("used") // "new" (máy mới) | "used" (máy cũ)
  // Tình trạng hàng: "con_hang" | "het_hang" | "sap_ve"
  stockStatus         String  @default("con_hang")
  // Tùy chọn cấu hình + giá: JSON [{label, price}] — bấm ở trang SP đổi giá.
  options             Json?
  isFlashSale         Boolean @default(false)
  flashSold           Int?
  accent              String  @default("dark")
  images              String[]
  // Dòng máy (series) = slug danh mục con theo hãng, VD "lenovo-thinkpad".
  // Trang /danh-muc/<series> (Category group="dong-may") lọc SP theo cột này.
  series              String?
  needs               String[] // slug nhu cầu: van-phong, gaming, sinh-vien...
  commitments         String[]
  description         Json? // các khối nội dung (đoạn văn / ảnh)
  // Slug các máy CÙNG DÒNG khác cấu hình (admin tự nối bằng link). Trang chi
  // tiết hiện chúng thành nút chọn "Dung lượng" để khách nhảy qua lại.
  variantSlugs        String[]
  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Email admin THÊM/SỬA sản phẩm này lần gần nhất (hiện ở bảng quản trị).
  updatedBy String?

  @@index([price])
  @@index([brandId])
  @@index([createdAt])
  @@index([isFeatured]) // trang chủ lọc theo cờ này
  @@index([series]) // trang dòng máy lọc theo cột này
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tag         String
  excerpt     String
  content     Json // các khối nội dung / đoạn văn
  readMinutes Int      @default(5)
  accent      String   @default("green")
  image       String?
  date        String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Order {
  id        String   @id @default(cuid())
  type      String // "purchase" | "tradein"
  name      String
  phone     String
  email     String?
  address   String
  note      String?
  items     Json? // đơn mua: danh sách sản phẩm
  total     Int?
  model     String? // đơn thu cũ: mẫu máy cần thu
  upgradeTo String?
  voucher   String? // mã giảm giá đã dùng (để đếm số lượt còn lại)
  status    String   @default("new") // new | processing | done | canceled
  userId    String? // gắn với tài khoản khách nếu đặt lúc đã đăng nhập
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([voucher])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String? // null nếu đăng nhập bằng Google (chưa đặt mật khẩu)
  image        String? // avatar (lấy từ Google nếu có)
  provider     String   @default("credentials") // credentials | google
  role         String   @default("user") // user | admin
  createdAt    DateTime @default(now())
}

// Token đặt lại mật khẩu (gửi qua email). Chỉ lưu SHA-256 của token, không lưu
// token thô -> lộ DB cũng không đặt lại được mật khẩu của khách.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime? // đã dùng -> không cho dùng lại
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Setting {
  key   String @id
  value String
}

model Page {
  id      String  @id // slug: gioi-thieu, lien-he, bao-hanh...
  title   String
  lead    String?
  content Json?
}

model Banner {
  id       String  @id @default(cuid())
  type     String // "hero" | "side"
  position Int     @default(0)
  image    String
  href     String?
  title    String?
  subtitle String?
  active   Boolean @default(true)
}

// Đếm lượt xem trang theo ngày (giờ VN). Dùng cho thống kê truy cập ở admin.
model DailyView {
  date  String @id // YYYY-MM-DD (giờ VN)
  count Int    @default(0)
}

// Phiên khách đang hoạt động (để ước lượng "đang truy cập").
model ActiveVisitor {
  id       String   @id // id ngẫu nhiên lưu ở localStorage khách
  lastSeen DateTime @default(now())

  @@index([lastSeen])
}
